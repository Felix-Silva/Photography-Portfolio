@page "/Gallery"
@using Azure.Storage.Blobs
@using FelixPhotography.Components.Flex
@using FelixPhotography.Components.Photos
@inject BlobServiceClient BlobServiceClient
@inject IConfiguration Config

<PageTitle>Gallery</PageTitle>

<Flex Gap="1rem" Width="100%">
    <Flex Direction="column" Gap="1rem" Width="33%">
        @foreach (var src in GetColumn(0))
        {
            <PhotoCard Src="@src" OnClick="OnPhotoClicked"></PhotoCard>
        }
    </Flex>
    <Flex Direction="column" Gap="1rem" Width="33%">
        @foreach (var src in GetColumn(1))
        {
            <PhotoCard Src="@src" OnClick="OnPhotoClicked"></PhotoCard>
        }
    </Flex>
    <Flex Direction="column" Gap="1rem" Width="33%">
        @foreach (var src in GetColumn(2))
        {
            <PhotoCard Src="@src" OnClick="OnPhotoClicked"></PhotoCard>
        }
    </Flex>
</Flex>